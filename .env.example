# Claude uses ANTHROPIC_API_KEY if set, otherwise the active `ant auth login` profile
# ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Pick one with: npm run pipeline -- voices
ELEVENLABS_VOICE_ID=
# Optional
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# MEDIA_BUCKET=gs://mintsy-media

# Worker (`pnpm worker`): local MongoDB only for testing, e.g. mongodb://localhost:27017
MONGODB_URI=
# MONGODB_DB=mintsy
# Fake every job (no Claude, ElevenLabs, Remotion or bucket upload); still writes studio_jobs + books
# STUDIO_WORKER_DRY_RUN=1
# Defaults to the machine's hostname; stale `running` jobs with this id are failed on startup
# STUDIO_WORKER_ID=
# STUDIO_WORKER_POLL_MS=2000

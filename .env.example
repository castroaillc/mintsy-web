PORT=4000
MONGODB_URI=mongodb://localhost:27017/mintsy?directConnection=true
# Optional: database name, if not in MONGODB_URI
MONGODB_DB=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated list of extra allowed frontend origins (the web app, https://app.getmintsy.com and in dev http://localhost:3000, is built in)
CORS_ORIGINS=http://localhost:3000
# Optional: public base URL for episode videos and thumbnails (default: the mintsy-media bucket)
MEDIA_BASE_URL=
# Optional: Expo access token, if enhanced push security is enabled
EXPO_ACCESS_TOKEN=
# Optional: media bucket name (default mintsy-media), used for signed URLs
MEDIA_BUCKET=
# Optional: "true" serves video/thumbnail URLs as short-lived GCS signed URLs (private bucket; see README)
SIGNED_MEDIA=
# RevenueCat webhook: the exact Authorization header value configured in RevenueCat (webhook returns 503 if unset)
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (sk_...), server-side only, for refetching subscribers
REVENUECAT_SECRET_API_KEY=
# Optional: Resend API key (re_...) for transactional email. Unset = emails are logged to the console instead
RESEND_API_KEY=
# Optional: sender address; its domain must be verified in Resend (default: mintsy <no-reply@getmintsy.com>)
EMAIL_FROM=
# Sign in with Google (native ID-token flow). Leave both client IDs empty to disable Google sign-in.
# Google Cloud console -> APIs & Services -> Credentials. Web application OAuth client ID (...apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# iOS OAuth client ID(s), comma-separated: one per bundle ID (com.getmintsy.app, com.getmintsy.app.dev).
# ID tokens from the iOS app have this audience; the web and iOS IDs are all accepted
GOOGLE_IOS_CLIENT_ID=
# Web client secret. Only used by the browser redirect flow (not by the app's ID-token sign-in)
GOOGLE_CLIENT_SECRET=
# Sign in with Apple. Leave APPLE_CLIENT_ID empty to disable Apple sign-in.
# Services ID from developer.apple.com (Identifiers -> Services IDs), e.g. com.getmintsy.signin
APPLE_CLIENT_ID=
# Client secret JWT (ES256, signed with the Sign in with Apple key, max 6 months). Only used by the browser
# redirect flow (not by the app's ID-token sign-in); leave empty for native-only
APPLE_CLIENT_SECRET=
# Comma-separated bundle IDs accepted as the audience of native ID tokens (default: com.getmintsy.app,com.getmintsy.app.dev)
APPLE_APP_BUNDLE_IDENTIFIER=

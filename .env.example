# Backend URL. The iOS simulator can reach the host via localhost;
# the Android emulator needs http://10.0.2.2:4000, a physical device needs your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# RevenueCat public SDK keys (Project settings › API keys › the iOS / Android app's public key).
# Without the key for a platform, purchases are off there: nobody is Premium on the device and the paywall shows its retry state.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

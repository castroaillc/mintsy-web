PORT=4000
MONGODB_URI=mongodb://localhost:27017/backend?directConnection=true
# Optional: database name, if not in MONGODB_URI
MONGODB_DB=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Optional: Expo access token, if enhanced push security is enabled
EXPO_ACCESS_TOKEN=

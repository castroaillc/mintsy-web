PORT=4000
MONGODB_URI=mongodb://localhost:27017/mintsy?directConnection=true
# Optional: database name, if not in MONGODB_URI
MONGODB_DB=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Optional: public base URL for episode videos and thumbnails (default: the mintsy-media bucket)
MEDIA_BASE_URL=
# Optional: Expo access token, if enhanced push security is enabled
EXPO_ACCESS_TOKEN=
# Optional: media bucket name (default mintsy-media), used for signed URLs
MEDIA_BUCKET=
# Optional: "true" serves video/thumbnail URLs as short-lived GCS signed URLs (private bucket; see README)
SIGNED_MEDIA=
# RevenueCat webhook: the exact Authorization header value configured in RevenueCat (webhook returns 503 if unset)
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (sk_...), server-side only, for refetching subscribers
REVENUECAT_SECRET_API_KEY=
# Optional: Resend API key (re_...) for transactional email. Unset = emails are logged to the console instead
RESEND_API_KEY=
# Optional: sender address; its domain must be verified in Resend (default: mintsy <no-reply@getmintsy.com>)
EMAIL_FROM=

# Claude runs through the Claude Code CLI on your subscription: install `claude` and run `claude auth login`.
# API keys are ignored and never passed to it, so don't add ANTHROPIC_API_KEY here.
# How long one Claude call may run before it's killed (default 30 minutes)
# STUDIO_CLAUDE_TIMEOUT_MS=1800000
# Narration is always Kokoro (local; setup in tts/README.md).
# Kokoro voices to make for every episode, each rendered to its own video; the first is the default
# KOKORO_VOICES=af_heart,am_michael,bm_george
# KOKORO_SPEED=1
# Collage polish (spring motion, scene wipes, SFX, music ducking, designed thumbnail); 0 turns it off
# STUDIO_POLISH=1
# Defaults to the production media bucket
# MEDIA_BUCKET=gs://mintsy-media
# Service account key for bucket uploads, used instead of your gcloud login. The default is used if the
# file exists, otherwise uploads fall back to your gcloud login. Set explicitly, the file must exist.
# STUDIO_GCP_KEY_FILE=~/.config/mintsy/studio-uploader.json

# Worker (`pnpm worker`): local MongoDB only for testing, e.g. mongodb://localhost:27017
MONGODB_URI=
# Holds books, studio_jobs and studio_workers
# MONGODB_DB=mintsy_studio
# Fake every job (no Claude, Kokoro, Remotion or bucket upload); still writes studio_jobs + books
# STUDIO_WORKER_DRY_RUN=1
# Defaults to the machine's hostname; stale `running` jobs with this id are failed on startup
# STUDIO_WORKER_ID=
# STUDIO_WORKER_POLL_MS=2000
# Use another folder instead of work/, e.g. a scratch copy for test renders
# STUDIO_WORK_DIR=

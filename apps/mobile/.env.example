# Backend URL. The iOS simulator can reach the host via localhost;
# the Android emulator needs http://10.0.2.2:4000, a physical device needs your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Stream episodes over HLS when the API offers Episode.hlsUrl. On only when exactly "true".
# Don't enable it for any build pointing at an API without hlsUrl: the catalog request fails and the app loses every book.
EXPO_PUBLIC_HLS_ENABLED=false

# RevenueCat public SDK keys (Project settings › API keys › the iOS / Android app's public key).
# Without the key for a platform, purchases are off there: nobody is Premium on the device and the paywall shows its retry state.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Mintsy Preview (com.getmintsy.app.preview) has its own RevenueCat app and keys; it never uses the ones above.
# Must be the platform key (appl_/goog_), never a Test Store key (test_): the SDK aborts release builds that use one.
EXPO_PUBLIC_REVENUECAT_IOS_KEY_PREVIEW=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY_PREVIEW=

# Sign in with Google (Google Cloud console › APIs & Services › Credentials, OAuth client IDs). No Firebase.
# The web client ID is the ID token audience the backend checks (also used on Android); one for both variants.
# Leave the variables for a variant empty to hide the Google button in that build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client IDs are per bundle id: production Mintsy (com.getmintsy.app) ...
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# ... and Mintsy Dev (com.getmintsy.app.dev, local runs and the development EAS profile).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_DEV=
# ... and Mintsy Preview (com.getmintsy.app.preview, the preview EAS profile).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_PREVIEW=
# Reversed iOS client IDs (com.googleusercontent.apps.<id>), the URL schemes Google returns to.
# Optional: derived from the matching client ID above when empty.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME_DEV=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME_PREVIEW=

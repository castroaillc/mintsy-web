# None of these are required: the public site (/, /privacy, /support) builds and runs without any env vars.

# The site's own origin. Default: https://getmintsy.com. The app links to /privacy and /support here.
NEXT_PUBLIC_SITE_URL=https://getmintsy.com

# The mintsy iPhone app on the App Store. Unset: the page says "App Store: coming soon" instead of linking.
NEXT_PUBLIC_APP_STORE_URL=

# --- Only for the paused web app (src/paused-app); unused by the public site ---

# Where the mintsy API (backend) runs. The web app proxies /api/auth/* and /graphql to it, so the browser
# only ever talks to this app's own origin and the session cookie stays first-party.
# Production: https://api.getmintsy.com · dev: http://localhost:4000
API_ORIGIN=http://localhost:4000

# RevenueCat Web Billing public API key (rcb_...). Unset: the paywall renders, but checkout is disabled.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=

# Comma-separated social sign-in buttons to show: apple, google. Default (unset): both.
# Set it to an empty value, or "none", to hide both.
NEXT_PUBLIC_SOCIAL_PROVIDERS=apple,google

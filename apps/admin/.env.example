# Copy to .env.local. Use a LOCAL MongoDB for testing; pointing at production means
# Publish goes live in the app immediately.
MONGODB_URI=mongodb://127.0.0.1:27017
# Holds books, studio_jobs and studio_workers only. Must match the studio worker's MONGODB_DB.
MONGODB_DB=mintsy_studio
MEDIA_BASE_URL=https://storage.googleapis.com/mintsy-media
# Where uploaded PDFs are saved as <bookId>.pdf (absolute path recommended). Default: ./uploads
UPLOAD_DIR=
# apps/studio/work on this machine, for the local preview on chapter pages. Default: ../studio/work
STUDIO_WORK_DIR=

// Mintsy Preview: the preview environment (its own API, database and RevenueCat app).
#include "Shared.xcconfig"

MINTSY_VARIANT = preview
PRODUCT_BUNDLE_IDENTIFIER = com.getmintsy.app.preview
MINTSY_DISPLAY_NAME = Mintsy Preview
// From design/icons/icon-preview.png (scripts/generate-brand.mjs)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Preview
MINTSY_URL_SCHEME = mintsy-preview
MINTSY_API_URL = $(MINTSY_API_URL_PREVIEW)

PORT=4000
MONGODB_URI=mongodb://localhost:27017/mintsy?directConnection=true
# Optional: app data database name (auth, push, entitlements, My List, progress), if not in MONGODB_URI
MONGODB_DB=
# Optional: database holding the catalog (books); this API only reads it. Unset = same database as app data
# mintsy_studio is the admin dashboard's and studio worker's default, so the local API serves what admin publishes
MONGODB_CATALOG_DB=mintsy_studio
# Optional: seconds the published catalog is kept in memory (default 60), so admin publishes show within this long.
# 0 = no cache (every read goes to MongoDB; ~1.3 s per request against Atlas)
CATALOG_CACHE_SECONDS=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated list of extra allowed frontend origins (the web app, https://app.getmintsy.com and in dev http://localhost:3000, is built in)
CORS_ORIGINS=http://localhost:3000
# Optional: comma-separated web app origins, replacing the built-in ones above. Leave it commented out to keep them;
# set but empty means no web app (the preview service)
# WEB_ORIGINS=
# Optional: public base URL for episode videos and thumbnails (default: the mintsy-media bucket)
MEDIA_BASE_URL=
# Optional: Expo access token, if enhanced push security is enabled
EXPO_ACCESS_TOKEN=
# APNs (Apple Push Notification service) for native iOS push tokens.
# Create an APNs auth key at developer.apple.com -> Certificates, IDs & Profiles -> Keys.
# All three set = native iOS device tokens are delivered; unset = skipped with a warning.
# APNS_AUTH_KEY: the full .p8 file contents; line breaks may be written as \n
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
# Optional: bundle ID sent as apns-topic (default: first APPLE_APP_BUNDLE_IDENTIFIER)
APNS_BUNDLE_ID=
# Optional: media bucket name (default mintsy-media), used for signed URLs
MEDIA_BUCKET=
# Optional: "true" serves video/thumbnail URLs as short-lived GCS signed URLs (private bucket; see README)
SIGNED_MEDIA=
# RevenueCat webhook: the exact Authorization header value configured in RevenueCat (webhook returns 503 if unset)
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (sk_...), server-side only, for refetching subscribers
REVENUECAT_SECRET_API_KEY=
# Optional: Resend API key (re_...) for transactional email. Unset = emails are logged to the console instead
RESEND_API_KEY=
# Optional: sender address; its domain must be verified in Resend (default: mintsy <no-reply@getmintsy.com>)
EMAIL_FROM=
# Sign in with Google (native ID-token flow). Leave both client IDs empty to disable Google sign-in.
# Google Cloud console -> APIs & Services -> Credentials. Web application OAuth client ID (...apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# iOS OAuth client ID(s), comma-separated: one per bundle ID (com.getmintsy.app, com.getmintsy.app.dev, com.getmintsy.app.preview).
# ID tokens from the iOS app have this audience; the web and iOS IDs are all accepted
GOOGLE_IOS_CLIENT_ID=
# Web client secret. Only used by the browser redirect flow (not by the app's ID-token sign-in)
GOOGLE_CLIENT_SECRET=
# Sign in with Apple. Leave APPLE_CLIENT_ID empty to disable Apple sign-in.
# Services ID from developer.apple.com (Identifiers -> Services IDs), e.g. com.getmintsy.signin
APPLE_CLIENT_ID=
# Client secret JWT (ES256, signed with the Sign in with Apple key, max 6 months). Only used by the browser
# redirect flow (not by the app's ID-token sign-in); leave empty for native-only
APPLE_CLIENT_SECRET=
# Comma-separated bundle IDs accepted as the audience of native ID tokens (default: com.getmintsy.app,com.getmintsy.app.dev,com.getmintsy.app.preview)
APPLE_APP_BUNDLE_IDENTIFIER=
# App Store (StoreKit 2) purchases, verified by this API. Everything below is optional.
# Comma-separated bundle IDs whose transactions and notifications are accepted (default: APPLE_APP_BUNDLE_IDENTIFIER,
# or all three app variants). Narrow it per service, e.g. com.getmintsy.app for production
APP_STORE_BUNDLE_IDS=
# Comma-separated subscription product ids that grant Premium (default: mintsy_premium_monthly,mintsy_premium_yearly)
APP_STORE_PRODUCT_IDS=
# Comma-separated StoreKit environments accepted: Production, Sandbox, Xcode, LocalTesting (default: Production,Sandbox).
# Sandbox covers TestFlight and App Review. Xcode and LocalTesting transactions can't be verified: they're accepted
# as they come, and never in production. Add Xcode here to buy with a StoreKit configuration file locally
APP_STORE_ENVIRONMENTS=
# App Store Server API key (App Store Connect -> Users and Access -> Integrations -> In-App Purchase): issuer ID,
# key ID and the .p8 file's contents (line breaks may be written as \n). All three set = refreshPremium refetches
# an App Store subscription from Apple; otherwise it returns what's stored
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
# The app's numeric Apple ID (App Store Connect -> App Information). Set = Production notifications for any other
# app are ignored
APP_STORE_APP_APPLE_ID=
